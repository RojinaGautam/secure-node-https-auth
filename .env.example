# Generate with: openssl rand -hex 32
AES_KEY_HEX=replace_with_64_hex_characters
# Generate independently with: openssl rand -hex 32
EMAIL_INDEX_KEY_HEX=replace_with_64_hex_characters
FRONTEND_ORIGIN=https://localhost:3443
BACKEND_PORT=4443
FRONTEND_PORT=3443
TLS_KEY_PATH=./certs/localhost-key.pem
TLS_CERT_PATH=./certs/localhost-cert.pem

# Local MongoDB; use a TLS-enabled authenticated URI for production.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=secure_auth
